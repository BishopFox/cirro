name: "User Assigned Identities"
label: "{{ LABELS.UserAssignedIdentity }}"
table_name: "resources"
resource_type: "microsoft.managedidentity/userassignedidentities"
properties:
  - "/id"
  - "/properties"
cypher: |
    UNWIND $batch AS row
    MERGE (obj:{{ LABELS.ArmResource }} {id: row.id})
    SET obj:{{ LABELS.UserAssignedIdentity }}
    SET obj += {
        clientId: row.properties.clientId,
        tenantId: row.properties.tenantId
    }
    MERGE (o:{{ LABELS.GraphObject }} {appId: row.properties.clientId})
    MERGE (obj)-[:{{ REL.REPRESENTED_BY }}]->(o)