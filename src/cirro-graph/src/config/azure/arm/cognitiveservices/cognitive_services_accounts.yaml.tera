name: "Cognitive Services"
label: "{{ LABELS.CognitiveServices }}"
table_name: "resources"
resource_type: "microsoft.cognitiveservices/accounts"
properties:
  - "/id"
  - "/properties"
cypher: |
    UNWIND $batch AS row
    MERGE (obj:{{ LABELS.ArmResource }} {id: row.id})
    SET obj:{{ LABELS.CognitiveServices }}
    SET obj += {
        customSubdomain: row.properties.customSubDomainName,
        endpoint: row.properties.endpoint,
        publicNetworkAccess: row.properties.publicNetworkAccess
    }